# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRADINGVIEW_WEBHOOK_SECRET: Secret authentication token to validate TradingView alert webhooks.
TRADINGVIEW_WEBHOOK_SECRET="smc_alpha_tv_secret_token"

# BROKER_API_KEY: Optional backend broker API key (e.g., Binance, Bybit, MT5 bridge) for Live Trading mode.
BROKER_API_KEY=""

# OANDA_API_KEY: Optional OANDA v20 REST API Personal Access Token.
# If omitted or if you do not have one, the platform seamlessly uses the TradingView OANDA Feed & Real-time Live Market Mirror.
OANDA_API_KEY=""

# OANDA_ACCOUNT_ID: Optional OANDA account ID (e.g., 101-001-XXXXXXX-001). Auto-discovered if omitted.
OANDA_ACCOUNT_ID=""

# OANDA_ENV: "practice" (default) or "live"
OANDA_ENV="practice"

